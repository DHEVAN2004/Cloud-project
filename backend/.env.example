# Copy this file to .env and replace placeholders locally.
# Spring Boot does not automatically load .env; export these values into your shell.
DB_URL=jdbc:mysql://localhost:3306/cloudvm_manager?serverTimezone=UTC
DB_USERNAME=replace_with_mysql_username
DB_PASSWORD=replace_with_mysql_password
JWT_SECRET=replace_with_base64_encoded_key_of_at_least_32_bytes
